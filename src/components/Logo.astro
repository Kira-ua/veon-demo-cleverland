---
// Client logo (file from the client's current site header), shown with mix-blend-mode: multiply on light paper.
interface Props { size?: "header" | "footer"; }
const { size = "header" } = Astro.props;
---
<a class:list={["logo", `logo--${size}`]} href="#top" aria-label="Clever Land, на початок сторінки">
  <picture>
    <source type="image/webp" srcset="img/logo-160.webp 160w, img/logo-320.webp 320w" sizes="(min-width: 64rem) 112px, 78px" />
    <img src="img/logo-160.jpg" srcset="img/logo-160.jpg 160w, img/logo-320.jpg 320w" sizes="(min-width: 64rem) 112px, 78px" width="160" height="97" alt="Clever Land" />
  </picture>
</a>
