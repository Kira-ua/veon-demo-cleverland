---
import Logo from "./Logo.astro";
import CallButton from "./CallButton.astro";
import { navAnchors, phone } from "../data/site";
---
<header class="site-header" data-rec="W-R001">
  <div class="container site-header__bar">
    <Logo />
    <nav class="site-nav" id="site-nav" aria-label="Розділи сторінки">
      <ul class="site-nav__list">
        {navAnchors.map((a) => <li><a class="site-nav__link" href={a.href}>{a.label}</a></li>)}
      </ul>
      <a class="site-nav__phone" href={phone.href}>{phone.label}</a>
    </nav>
    <div class="site-header__actions">
      <a class="site-header__phone tnum" href={phone.href}>{phone.label}</a>
      <CallButton class="site-header__call" />
      <a class="btn btn--call btn--icon site-header__call-sm" href={phone.href} aria-label={`Дзвінок: ${phone.label}`}>
        <svg class="btn__icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span aria-hidden="true">Дзвінок</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-toggle__bars" aria-hidden="true"></span>
        <span class="visually-hidden">Меню</span>
      </button>
    </div>
  </div>
</header>
